<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.8.10</Version>
    <ApplicationIcon>taswib.ico</ApplicationIcon>
    <AssemblyName>Taswib</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="contact.png" /></ItemGroup>
  <ItemGroup><PackageReference Include="Velopack" Version="1.2.161" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\Taswib.Core\Taswib.Core.csproj" /></ItemGroup>
</Project>
