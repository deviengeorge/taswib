<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Taswib" x:Class="Taswib.WelcomeWindow"
        Title="{l:Tr w_title}" Icon="/taswib.ico" Width="540" Height="330" CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24,20,24,22">
    <TextBlock DockPanel.Dock="Top" Classes="title" Text="{l:Tr w_title}"/>
    <TextBlock DockPanel.Dock="Top" x:Name="Body" Classes="sub" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
      <Button x:Name="OpenSettingsBtn" Content="{l:Tr w_settings}"/>
      <Button x:Name="Ok" Classes="accent" Content="{l:Tr w_ok}"/>
    </StackPanel>
    <TextBox x:Name="Sample" FlowDirection="LeftToRight" Text="high fd; ;dt phg;" FontSize="20" AcceptsReturn="True" TextWrapping="Wrap"/>
  </DockPanel>
</Window>
