<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Taswib" x:Class="Taswib.NewsWindow"
        Icon="/taswib.ico" Width="540" Height="280" CanResize="False" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24,20,24,22">
    <TextBlock DockPanel.Dock="Top" x:Name="Head" Classes="title"/>
    <Button DockPanel.Dock="Bottom" x:Name="Ok" Classes="accent" Content="{l:Tr w_ok}" HorizontalAlignment="Right"/>
    <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </DockPanel>
</Window>
